datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model strategies {
  id         String                @id @default(uuid()) @db.Uuid
  name       String?               @db.Text
  config     Json
  status     String?               @db.Text
  created_at DateTime              @default(now()) @db.Timestamp(6)
  updated_at DateTime              @updatedAt @db.Timestamp(6)
  executions strategy_executions[]
}

model strategy_executions {
  id                String      @id @default(uuid()) @db.Uuid
  strategy_id       String?     @db.Uuid
  strategy          strategies? @relation(fields: [strategy_id], references: [id], onDelete: SetNull)
  status            String?     @db.Text
  execution_details Json?       @db.JsonB
  final_pnl_percent  Decimal?    @db.Decimal
  total_pnl_rupees   Decimal?    @db.Decimal
  exit_type         String?     @db.Text
  started_at        DateTime    @default(now()) @db.Timestamp(6)
  completed_at      DateTime?   @db.Timestamp(6)
}
